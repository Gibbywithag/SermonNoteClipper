# ─────────────────────────────────────────────────────────────────────
# Sermon Note Clipper — server configuration (.env)
# Copy this file to .env and fill in what you need. Everything here is
# OPTIONAL — the app runs with just a Gemini API key entered in the UI.
# ─────────────────────────────────────────────────────────────────────

# AWS S3 (optional — silent off-site backup of generated clips)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Gemini models (optional — override if Google renames/retires a model)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Processing (optional)
# MAX_CONCURRENT_JOBS=5           # how many videos process at once
# DISABLE_YOUTUBE_URL=false       # set true to only allow file uploads (no URL ingest)

# CORS (optional — comma-separated origins allowed to call the API).
# Defaults to localhost dev ports; change only for a custom deployment.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5175
